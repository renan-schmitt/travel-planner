# Copie para .env e preencha. Nunca commite o .env.
# Em produção, os segredos vêm do Secret Manager (ver Fase 4 e Apêndice C do plano).

# Docker Compose (local): porta do MySQL no host
MYSQL_PORT=3307

# Perfil Spring / banco (a partir da Fase 4 em produção)
SPRING_PROFILES_ACTIVE=local
CLOUD_SQL_INSTANCE=
DB_USERNAME=
DB_PASSWORD=

# Autenticação Google (Fase 3). O perfil `local` do backend lê este arquivo.
# Redirect do cliente OAuth em dev: http://localhost:8082/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E-mails separados por vírgula
APP_ADMIN_EMAILS=

# Google Places (Fase 7)
PLACES_API_KEY=

# E-mail / lembretes (Fase 20)
SMTP_USERNAME=
SMTP_PASSWORD=
SCHEDULER_SA_EMAIL=

# Web Push (Fase 21)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Anexos (Fase 22)
GCS_BUCKET=

# IA / Gemini (Fase 23)
GEMINI_API_KEY=
